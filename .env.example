# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Provider keys are optional: PROVIDER_MODE=replay needs none, and replay is
# the default.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://travel:travel@localhost:5432/travel

# Cache + quota + arq. Must be set on BOTH the web service and the worker —
# they are separate processes, and a worker pointed elsewhere gets its own
# empty cache and no quota ceiling.
REDIS_URL=redis://localhost:6379/0

# replay | record | live. live/record cost real money and require approval.
PROVIDER_MODE=replay

# ── Auth ────────────────────────────────────────────────────────────────────
SESSION_SECRET=dev-secret-change-in-production
INGEST_BEARER_TOKEN=dev-ingest-token

# ── Provider credentials ────────────────────────────────────────────────────
SERPAPI_API_KEY=
OMKAR_API_KEY=
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
